# ============================================================
#  Секреты и оформление подписки
# ============================================================

# Домен для HTTPS (Caddy). Для локального запуска не нужен.
# DNS: A-запись домена -> IP московского VPS, Cloudflare DNS only.
DOMAIN=

# Адрес, на который docker публикует API (127.0.0.1 = только через Caddy)
BIND_ADDR=127.0.0.1

# Токен в ссылке подписки: /sub/<SUB_TOKEN>
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
SUB_TOKEN=change-me-sub-token

# Токен для /admin/* (Bearer)
ADMIN_TOKEN=change-me-admin-token

# Название профиля в Happ/Hiddify
PROFILE_TITLE=Moscow Auto-VPN

# Ссылка на Telegram (иконка в клиенте)
SUPPORT_URL=https://t.me/your_channel

# Необязательная web-страница профиля
# WEB_PAGE_URL=https://example.com

# Декоративная полоса трафика: total в байтах (300 GB = 322122547200)
TOTAL_BYTES=322122547200
# Дата истечения (unix). 1893456000 = 2030-01-01
EXPIRE_UNIX=1893456000

# ============================================================
#  Подписка
# ============================================================

# Сколько живых нод отдавать клиенту
NODES_IN_SUB=35
# Не более N нод из одной подсети /24 (IPv4) или одного домена 2-го уровня.
# Защищает от ситуации "весь топ — ноды одного провайдера". 0 = без ограничения.
MAX_NODES_PER_SUBNET=8

# ============================================================
#  Чекер
# ============================================================

# Нод в одном временном конфиге sing-box
BATCH_SIZE=70
# Таймаут одного HTTP-запроса через ноду, сек
CHECK_TIMEOUT=4
# Параллельных проб внутри батча (20 — безопасный предел для домашнего канала)
PROBE_CONCURRENCY=20
# Начало выделенного диапазона портов для inbound'ов (вне эфемерного пула ОС)
PORT_BASE=20000
# Ширина одной полосы; между сканами полосы ротируются, чтобы не пересекаться с TIME_WAIT
PORT_BAND=3000
# Максимум нод за один полный скан (защита CPU)
MAX_NODES_PER_SCAN=1500
# Не отдавать в подписку ноды медленнее этого значения (мс)
MAX_LATENCY_MS=8000

# ============================================================
#  Расписание
# ============================================================

# Полный скан (сек), по умолчанию 1 час
FULL_SCAN_INTERVAL=3600
# Быстрый речек живых нод (сек), по умолчанию 10 минут
LIVE_RECHECK_INTERVAL=600
# Выключить фоновые задачи (для тестов)
SCHEDULER_ENABLED=true

# ============================================================
#  Прочее
# ============================================================

DATA_DIR=data
SINGBOX_PATH=sing-box
LOG_LEVEL=INFO
# Доверять X-Forwarded-For (только если сервис не доступен напрямую)
TRUST_FORWARDED_FOR=true
RATE_LIMIT_PER_MIN=120
