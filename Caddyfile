# Runtime logs only (ERROR). Access logs are disabled on purpose:
# subscription URLs contain the secret token.
{
	log {
		level ERROR
	}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	reverse_proxy aggregator:8000

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
